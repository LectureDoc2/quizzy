{
  "name": "ld-quiz-server",
  "version": "1.0.0",
  "description": "Real-time quiz backend (API + WebSocket) and the web pages served alongside it",
  "type": "module",
  "private": true,
  "license": "BSD-3-Clause",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "test:watch": "node --test --watch test/*.test.js",
    "test:browser": "node --test test/browser/*.test.js",
    "test:all": "npm run test && npm run test:browser"
  },
  "dependencies": {
    "express": "^5.2.1",
    "katex": "^0.17.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  }
}
