{
  "name": "quizzy",
  "version": "1.0.0",
  "description": "Real-time, embeddable quiz application for HTML-based presentation systems (e.g. LectureDoc2)",
  "type": "module",
  "author": "Michael Eichberg",
  "private": true,
  "license": "BSD-3-Clause",
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "start": "pnpm --filter ld-quiz-server start",
    "dev": "pnpm build && pnpm --filter ld-quiz-server start",
    "test": "pnpm --filter ld-quiz-server test",
    "test:browser": "pnpm --filter ld-quiz-server test:browser",
    "test:all": "pnpm --filter ld-quiz-server test:all",
    "encrypt": "node tools/encrypt-quiz.js",
    "validate": "node tools/validate-quiz.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lecturedoc2/libcrypto": "^1.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
