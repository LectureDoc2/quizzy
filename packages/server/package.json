{
  "name": "ld-quiz-server",
  "version": "1.0.0",
  "description": "Real-time quiz backend (API + WebSocket) and the web pages served alongside it",
  "type": "module",
  "private": true,
  "license": "BSD-3-Clause",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "test:watch": "node --test --watch test/*.test.js",
    "test:browser": "node --test test/browser/*.test.js",
    "test:all": "npm run test && npm run test:browser"
  },
  "dependencies": {
    "@lecturedoc2/libcrypto": "^1.1.0",
    "express": "^5.3.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
