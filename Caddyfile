# Caddy sits in front of the Node quiz backend.
# It serves static files directly and proxies API/WebSocket traffic.
#
# Environment variables (all optional):
#   CADDY_HOST      Site address, e.g. localhost, 192.168.178.161, quiz.example.com
#   BACKEND_HOST    Host of the Node backend (default: localhost)
#   BACKEND_PORT    Port of the Node backend (default: 3000)
#   TLS_CONFIG      Path to a TLS snippet file (default: caddy/tls-auto.txt)
#
# IPv6: an address literal must be bracketed, because the reverse_proxy targets
# below append ":port". Setting BACKEND_HOST=::1 produces "::1:3000", which is
# not a valid address -- use BACKEND_HOST=[::1] to get "[::1]:3000". The default
# of "localhost" needs no special handling: it resolves to whichever families
# the host has, so it is the right choice on IPv6-only infrastructure too.
#
# Examples:
#   caddy run --config Caddyfile
#   CADDY_HOST=192.168.178.161 TLS_CONFIG=caddy/tls-mkcert.txt caddy run --config Caddyfile
#   CADDY_HOST=quiz.example.com caddy run --config Caddyfile
#   CADDY_HOST=quiz.example.com BACKEND_HOST=[::1] caddy run --config Caddyfile
{
	http_port {$HTTP_PORT:80}
	https_port {$HTTPS_PORT:443}
	email michael.eichberg@dhbw.de
	acme_ca https://certificates.dhbw.cloud/acme/directory
}

{$CADDY_HOST:localhost} {
	# TLS snippet. Leave empty for automatic HTTPS (production) or local HTTP.
	# For local HTTPS with mkcert set TLS_CONFIG=caddy/tls-mkcert.txt.
	import {$TLS_CONFIG:caddy/tls-auto.txt}

	# WebSocket endpoint -> Node backend
	handle /ws {
		reverse_proxy {$BACKEND_HOST:localhost}:{$BACKEND_PORT:3000}
	}

	# API endpoint -> Node backend
	handle /api/* {
		reverse_proxy {$BACKEND_HOST:localhost}:{$BACKEND_PORT:3000}
	}

	# Client bundles come in two flavours; see build.js for why.
	#
	#   /client/<version>/...  never changes, so it may be cached forever and
	#                          pinned with Subresource Integrity. This is the URL
	#                          an external embedder -- a LectureDoc2 deck, a
	#                          Moodle course -- should reference.
	#   /client/...            tracks the deployment, so it must not be cached,
	#                          or the pages served alongside it would keep using
	#                          the previous release.
	#
	# path_regexp rather than the `path` matcher on purpose: Caddy's `path`
	# wildcards match across slashes, so `/client/*.js` would also catch the
	# versioned copies and cache-bust exactly what is meant to be immutable.
	@client_versioned path_regexp ^/client/v?[0-9][^/]*/
	@client_moving path_regexp ^/client/[^/]+$

	# Static files served directly by Caddy from the build output.
	# Run `pnpm build` to (re-)generate `dist/`.
	handle {
		header Access-Control-Allow-Origin "*"

		header @client_versioned Cache-Control "public, max-age=31536000, immutable"
		header @client_moving Cache-Control "no-cache"

		# The control page holds the presenter token, so it gets a strict CSP.
		# This is the authoritative copy; control.html carries the same policy in
		# a <meta> tag so that development and non-Caddy deployments are covered.
		#
		#   script-src 'self'   blocks inline event handlers (onerror=, onload=),
		#                       which are the only route from injected markup to
		#                       code execution -- innerHTML never runs <script>.
		#   connect-src 'self'  matches ws:/wss: on this origin, so the control
		#                       WebSocket keeps working while exfiltration to any
		#                       other host is refused.
		#   img-src             stays narrow on purpose: an <img> pointing at a
		#                       foreign host is the cheapest way to leak a token.
		#                       Add explicit hosts here if a quiz needs them.
		#   style-src-attr      allows the inline style="..." attributes that
		#                       lecturer-authored quiz HTML and SVG rely on.
		#
		# frame-ancestors is set here rather than in the <meta> tag, where it is
		# ignored by browsers.
		#
		# Deliberately NOT applied to index.html / demo.html: those embed the
		# ld-quiz web component, which injects a <style> element into its shadow
		# root and would need style-src 'unsafe-inline'.
		header /control.html {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; object-src 'none'; form-action 'none'; frame-ancestors 'none'"
			Referrer-Policy "no-referrer"
			X-Content-Type-Options "nosniff"
		}

		root * dist
		file_server
	}
}
